# Only enable for a fictional, publicly accessible evaluation environment.
DEMO_MODE=true
# These are provisioned by Replit AI Integrations. Never commit actual values.
AI_INTEGRATIONS_OPENAI_BASE_URL=
AI_INTEGRATIONS_OPENAI_API_KEY=
