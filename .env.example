# Copy this file to backend/.env for local development. Never commit backend/.env.
# Set a PostgreSQL connection URL for your own local/development database.
DATABASE_URL=
# Use a strong random secret, e.g. generated with: openssl rand -hex 32
SESSION_SECRET=
# Optional separate mock-webhook signing secret; otherwise SESSION_SECRET is used.
WEBHOOK_SECRET=
PORT=8080
# Fictional demo identities and registration. Disable for production.
DEMO_MODE=true
# Standalone clones: supply your own OpenAI API key.
OPENAI_API_KEY=
# Replit uses these instead when its managed OpenAI integration is configured.
AI_INTEGRATIONS_OPENAI_BASE_URL=
AI_INTEGRATIONS_OPENAI_API_KEY=
